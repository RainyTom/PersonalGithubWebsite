{
  "name": "rainytom-wiki",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "docs:dev": "node scripts/dev.js",
    "docs:build": "npm run sidebar && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "dev": "npm run docs:dev",
    "build": "npm run docs:build",
    "preview": "npm run docs:preview",
    "sidebar": "node scripts/update-sidebar.js",
    "check": "vue-tsc --noEmit",
    "generate": "node --env-file-if-exists=.env scripts/generate-content.js",
    "test": "node --test tests/*.test.js",
    "source": "node scripts/export-source.js"
  },
  "dependencies": {
    "mermaid": "12.2.0",
    "vue": "3.5.44",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "vitepress": "2.0.0-alpha.20",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.1",
    "@types/node": "^24.0.0"
  }
}
