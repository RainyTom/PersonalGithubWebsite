---
import Base from '../layouts/Base.astro';
import PostCard from './PostCard.astro';
import { href, tagHref, tagCounts, type Post } from '../lib/posts';
interface Props { posts: Post[]; all: Post[]; current: number; total: number; }
const { posts, all, current, total } = Astro.props;
const categories = tagCounts(all);
const pageHref = (page: number) => page === 1 ? href() : href(`page/${page}/`);
---
<Base title={current > 1 ? `文章 · 第 ${current} 页` : undefined}>
  <section class="intro">
    <div class="eyebrow"><span class="status-dot"></span> A SMALL SPACE FOR BIG CURIOSITIES</div>
    <h1>在日常之间，<br />留一点<span class="accent">思考的空白。</span></h1>
    <p>写一点代码，读几页书，观察生活。<br class="desktop-break" />这里收藏技术里的思考，和日子里不经意的发现。</p>
    <a class="intro-link" href={href('about/')}>认识一下这个小站 <span aria-hidden="true">↗</span></a>
    <span class="intro-decoration" aria-hidden="true">*</span>
  </section>
  <section aria-labelledby="articles-heading">
    <div class="section-heading"><h2 id="articles-heading">最近的记录 <span>{String(all.length).padStart(2, '0')}</span></h2><a href={href('rss.xml')}>订阅 RSS ↗</a></div>
    <div class="filter-bar" aria-label="按标签浏览"><a class="filter active" href={href()} aria-current="page">全部文章</a>{categories.slice(0, 5).map(([tag, count]) => <a class="filter" href={tagHref(tag)}>{tag}<small>{count}</small></a>)}</div>
    <div class="post-list">{posts.map(post => <PostCard post={post} />)}</div>
    {total > 1 && <nav class="pagination" aria-label="文章分页"><span>第 {current} / {total} 页</span><div>{current > 1 && <a href={pageHref(current - 1)}>← 上一页</a>}{current < total && <a href={pageHref(current + 1)}>下一页 →</a>}</div></nav>}
    {!posts.length && <p class="empty">第一篇记录正在路上。</p>}
  </section>
  <aside class="subscribe"><span class="subscribe-icon" aria-hidden="true">↗</span><div><h2>让好内容，慢一点抵达。</h2><p>通过 RSS 订阅，在你喜欢的阅读器里相遇。</p></div><a href={href('rss.xml')}>订阅更新 <span aria-hidden="true">→</span></a></aside>
</Base>
