---
import { displayDate, postHref, type Post } from '../lib/posts';
interface Props { post: Post; }
const { post } = Astro.props;
---
<article class="post-card" data-kind="post">
  <div class="post-meta"><time datetime={post.data.date}>{displayDate(post.data.date)}</time><span aria-hidden="true">/</span><span>{post.data.tags[0]}</span></div>
  <h2><a href={postHref(post)}>{post.data.title}<span aria-hidden="true" class="post-arrow">↗</span></a></h2>
  <p>{post.data.summary}</p>
</article>
