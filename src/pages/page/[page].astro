---
import Listing from '../../components/Listing.astro';
import { allPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const all = await allPosts();
  const total = Math.ceil(all.length / 5);
  return Array.from({ length: Math.max(0, total - 1) }, (_, index) => ({ params: { page: String(index + 2) }, props: { all, current: index + 2, total } }));
}
const { all, current, total } = Astro.props;
---
<Listing posts={all.slice((current - 1) * 5, current * 5)} all={all} current={current} total={total} />
