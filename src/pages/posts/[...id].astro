---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allPosts, displayDate, href, postHref, tagHref } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post, index) => ({ params: { id: post.id }, props: { post, older: posts[index + 1], newer: posts[index - 1] } }));
}
const { post, older, newer } = Astro.props;
const { Content } = await render(post);
const labels = { manual: '手写记录', library: '本地主题库 · 每日练习', openai: 'AI 辅助生成 · 请核实事实' };
---
<Base title={post.data.title} description={post.data.summary} type="article" date={post.data.date}>
  <article class="article-page">
    <a class="back-link" href={href()}>← 全部文章</a>
    <header class="article-header"><div class="post-meta"><time datetime={post.data.date}>{displayDate(post.data.date)}</time><span>/</span><span>{labels[post.data.source]}</span></div><h1>{post.data.title}</h1><p class="article-summary">{post.data.summary}</p><div class="tags">{post.data.tags.map(tag => <a href={tagHref(tag)}># {tag}</a>)}</div></header>
    <div class="prose"><Content /></div>
    <nav class="post-navigation" aria-label="相邻文章"><div>{older && <a href={postHref(older)}><small>← 上一篇 · 更早</small>{older.data.title}</a>}</div><div>{newer && <a href={postHref(newer)}><small>下一篇 · 更新 →</small>{newer.data.title}</a>}</div></nav>
  </article>
</Base>
